{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "work.duebuddy/invoices",
  "description": "Read supplier invoices (PDF, photo, XML e-invoices) via MCP and get structured data plus a DATEV/1C/CSV file.",
  "version": "1.1.0",
  "websiteUrl": "https://duebuddy.work/mcp-docs",
  "repository": {
    "url": "https://github.com/ANTONDrakon/duebuddy-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "duebuddy-mcp",
      "version": "1.1.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "duebuddy-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DUEBUDDY_API_KEY",
          "description": "DueBuddy API key. Five invoices are free, no card required.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://duebuddy.work/mcp"
    }
  ]
}